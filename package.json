{
  "name": "@hanxu131/dsh-zotero",
  "version": "0.2.0",
  "description": "DSH 内访问与操作 Zotero 文库的独立插件（右侧标签：检索、详情、PDF、注释、高亮与 Agent 工具）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./client.pdf.js": { "default": "./lib/client.pdf.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE", "NOTICE", "THIRD_PARTY_NOTICES.md"],
  "license": "Apache-2.0",
  "author": "hanxu131",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "zotero", "reference", "literature"],
  "engines": { "node": "^22.19.0 || >=24", "dsh": ">=0.2.1-rc.1 <0.3.0-0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"] }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-pdfjs.mjs && node scripts/build-client.mjs",
    "watch": "tsc -p tsconfig.json --noEmit && node scripts/copy-pdfjs.mjs && node scripts/build-client.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf lib",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/schemastery": "^3.18.1" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dompurify": "^3.2.4",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
